<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Michigan Weekend Adventures</title>
  <!-- Bootstrap 5.3 CDN (requires internet) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Local option: disable CDN above before enabling this.
  <link href="../styles/bootstrap.min.css" rel="stylesheet">
  -->
  <link href="../styles/adventures.css" rel="stylesheet">
</head>


<body>
  <main class="container py-5">
    <h1>Michigan Weekend Adventures</h1>
    <p class="lead">Three beautiful Michigan destinations.</p>
    <section aria-labelledby="destinations">
      <h2 id="destinations" class="h4 mb-4">Featured destinations</h2>
      <div class="row g-4">
      <article class="col-12 col-md-4">
        <div class="card h-100">
          <img src="../images/pictured-rocks.svg" class="card-img-top" alt="Illustration of Pictured Rocks">
          <div class="card-body d-flex flex-column">
            <h3 class="h5">Pictured Rocks</h3>
            <p>Discover the scenery and outdoor activities.</p>
            <a class="btn btn-success mt-auto" href="https://www.nps.gov/">Explore parks</a>
          </div>
        </div>
      </article>
      <article class="col-12 col-md-4">
        <div class="card h-100">
          <img src="../images/sleeping-bear.svg" class="card-img-top" alt="Illustration of Sleeping Bear Dunes">
          <div class="card-body d-flex flex-column">
            <h3 class="h5">Sleeping Bear Dunes</h3>
            <p>Discover the scenery and outdoor activities.</p>
            <a class="btn btn-success mt-auto" href="https://www.nps.gov/">Explore parks</a>
          </div>
        </div>
      </article>
      <article class="col-12 col-md-4">
        <div class="card h-100">
          <img src="../images/tahquamenon.svg" class="card-img-top" alt="Illustration of Tahquamenon Falls">
          <div class="card-body d-flex flex-column">
            <h3 class="h5">Tahquamenon Falls</h3>
            <p>Discover the scenery and outdoor activities.</p>
            <a class="btn btn-success mt-auto" href="https://www.nps.gov/">Explore parks</a>
          </div>
        </div>
      </article>
      </div>
    </section>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Local option (disable CDN before enabling):
  <script src="../scripts/bootstrap.bundle.min.js"></script>
  -->
</body>
</html>


